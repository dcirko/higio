{
  "expo": {
    "name": "Higio",
    "slug": "higio",
    "description": "Brzo i privatno praćenje osobne higijene i njege.",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "higio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.domag.higio",
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": "./assets/expo.icon",
      "supportsTablet": false
    },
    "android": {
      "package": "com.domag.higio",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF7F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#217D5C",
          "defaultChannel": "higio-reminders-v2",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Omogući Higiju korištenje Face ID-a za zaključavanje aplikacije."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Omogući Higiju korištenje Face ID-a za zaštitu lokalnih postavki."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
